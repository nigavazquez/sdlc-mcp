{
  "name": "sdlc-mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP remoto compartido que orquesta el flujo SDLC tradicional (PRD, RFC, tareas, implementación, QA, code review) con agentes especializados por rol.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "local": "turbo run build && pnpm --filter @sdlc/server dev",
    "lint": "pnpm run lint:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "lint:boundaries": "depcruise apps/server/src packages --config .dependency-cruiser.cjs --output-type err"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "dependency-cruiser": "^16.10.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
