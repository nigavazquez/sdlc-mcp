# Instancia local real del sdlc-mcp en Docker. Copiar a infra/.env.local (gitignored).
# Ver los comandos al principio de infra/compose.yml.

# Separa contenedores, red y volumen de Postgres de otras instancias (p. ej. la del
# ejemplo 02, que usa el proyecto por default "infra").
COMPOSE_PROJECT_NAME=sdlc-local

# Puertos en el host. La base sólo en loopback.
SDLC_PORT=3000
SDLC_PG_BIND=127.0.0.1:5435

# Estructura de la organización (relativo a infra/). sdlc.config.yaml está gitignored.
SDLC_CONFIG_FILE=../sdlc.config.yaml

# Tiene que coincidir con el redirect URI registrado: <PUBLIC_URL>/oauth/callback
PUBLIC_URL=http://localhost:3000

# Login: client OAuth de tipo "Web application" (docs/runbook-google-sso.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# openssl rand -hex 32. No rotar sin avisar: invalida todos los tokens y sesiones.
OAUTH_SIGNING_SECRET=
ADMIN_SESSION_SECRET=

# Secretos de las integraciones: secret_ref aws-sm://<name> → SECRET_<NAME>.
# Doc store en Mi unidad: la salida de `pnpm --filter @sdlc/server drive:auth`, en una línea
# y entre comillas simples.
# SECRET_GDRIVE_USER='{"type":"authorized_user",...}'
# SECRET_GITHUB_TOKEN=

# Diagramas mermaid como imagen en los documentos de Drive: lo resuelve el servicio
# `diagrams` del compose. Vacío = los diagramas quedan como código.
# DIAGRAMS_URL=http://diagrams:3100

# Aprobación humana de PRD, RFC y criterios (RFC aprobacion-de-fases). Lista de
# workspaces separada por comas, o * para todos. Vacío: el flow avanza sin aprobación.
# APPROVALS_REQUIRED=sdlc-mcp
