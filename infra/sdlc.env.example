# Copiar a /etc/sdlc/sdlc.env en la instancia (root:root 0644).
#
# Acá NO va ningún secreto. Los secretos son referencias que resuelve el instance
# role, y viven en compose.prod.yml (o se pisan con las SDLC_*_REF de abajo).
# Si algún día aparece un valor de credencial en este archivo, está mal puesto.

# Imagen a correr. El tag es inmutable (el sha del commit), nunca `latest`: es lo
# único que hace que un rollback sea "poné el tag anterior" y no "buildeá de nuevo".
SDLC_IMAGE=<account-id>.dkr.ecr.us-east-1.amazonaws.com/sdlc-mcp:<git-sha>

# Dominio público. PUBLIC_URL es el issuer OAuth y la base de los redirect URIs:
# tiene que coincidir exacto con lo registrado en el proveedor OIDC.
SDLC_DOMAIN=sdlc-mcp.example.com
PUBLIC_URL=https://sdlc-mcp.example.com
SDLC_TLS_EMAIL=infra@example.com

AWS_REGION=us-east-1
LOG_LEVEL=info

# Referencias a Secrets Manager. Los defaults de compose.prod.yml ya apuntan acá;
# descomentá sólo si los secretos tienen otro nombre.
# SDLC_DATABASE_URL_REF=aws-sm://sdlc/prod/db#url
# SDLC_OAUTH_SIGNING_SECRET_REF=aws-sm://sdlc/prod/oauth#signing_secret
# SDLC_ADMIN_SESSION_SECRET_REF=aws-sm://sdlc/prod/oauth#admin_session_secret

# Nombre (no valor) del secreto con la password de Postgres. deploy.sh lo lee con
# el instance role y lo pasa por el entorno del comando, sin tocar el disco.
SDLC_DB_SECRET_NAME=sdlc/prod/db

# Rate limiting y traces. Los defaults sirven para esta instancia —el límite viene
# prendido, los traces apagados—, así que esto es sólo la perilla: descomentá lo que
# quieras mover. Un valor inválido rompe el arranque a propósito, en vez de caer en
# silencio al default. Ver apps/server/.env.example para qué mide cada bucket.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MCP_MAX=240
# RATE_LIMIT_ADMIN_MAX=300
# RATE_LIMIT_OAUTH_MAX=60
# RATE_LIMIT_DEFAULT_MAX=120

# Prender los traces sin endpoint rompe el arranque: traces sin destino parecen andar
# y no exportan nada.
# OTEL_TRACES_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
# OTEL_SERVICE_NAME=sdlc-mcp
