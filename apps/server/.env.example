# Copiar a apps/server/.env y editar. Todo tiene default razonable para dev:
# sin ninguna de estas variables el server arranca in-memory en localhost:3000.
#
# OJO con la precedencia: si existe un sdlc.config.yaml, lo que ese archivo define
# **gana** sobre la env var equivalente (TENANT_ID, ADMIN_EMAILS,
# ALLOWED_EMAIL_DOMAINS y el bloque OIDC_*). Las env vars rellenan lo que el
# archivo omite. El boot loguea de qué fuente salió cada valor.

# ── Runtime ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Override del catálogo de prompts/skills/templates.
# Default: el catálogo bundleado en packages/catalog. Apuntá acá tu propio
# catálogo en vez de editar el bundleado.
# CATALOG_ROOT=/abs/path/to/my-catalog

# ── Estructura declarativa (workspaces, groups, labels, OIDC) ────────────────
# Ruta al sdlc.config.yaml. Default: ./sdlc.config.yaml relativo al cwd.
# En dev el cwd es apps/server, así que para usar el de la raíz del repo:
# SDLC_CONFIG=../../sdlc.config.yaml
# Ver sdlc.config.example.yaml.

# ── Persistencia ──────────────────────────────────────────────────────────────
# Si está seteado, se usa PostgresFlowStore (correr migraciones antes:
# pnpm --filter @sdlc/server db:migrate). Sin esto => InMemoryFlowStore, el
# estado se pierde al reiniciar y no corre la reconciliación de estructura.
DATABASE_URL=postgresql://sdlc:sdlc@localhost:5432/sdlc

# ── Secretos ──────────────────────────────────────────────────────────────────
# Backend para resolver secret-refs (aws-sm://name#key):
#   env  => lee de variables SECRET_<NAME> (dev/tests). Default.
#   aws  => AWS Secrets Manager vía la credential chain default del SDK.
SECRETS_BACKEND=env

# Requerido cuando SECRETS_BACKEND=aws.
# AWS_REGION=us-east-1
# Las credenciales salen de la chain default del SDK:
#   - local: AWS_PROFILE (con ~/.aws montado) o AWS_ACCESS_KEY_ID/SECRET/SESSION_TOKEN
#   - EC2:   el instance IAM role (nada que setear acá)
# AWS_PROFILE=default

# ── Observabilidad (OpenTelemetry) ────────────────────────────────────────────
# Traces de las llamadas MCP: una span por tool call, con tenant/workspace/flow
# como atributos. NO viaja contenido: ni el input, ni el resultado, ni el mensaje
# de error, ni la identidad de la persona. Apagado por default; apagado no se
# carga una línea del SDK de OTEL ni se envuelve el registry de tools.
# Prenderlo sin endpoint rompe el arranque a propósito: traces sin destino
# parecen andar y no exportan nada.
# OTEL_TRACES_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318   # el exporter le agrega /v1/traces
# OTEL_SERVICE_NAME=sdlc-mcp

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Prendido por default. El eje es la identidad efectiva del caller (access token
# Bearer → sesión del panel → IP) cruzada con la familia de rutas. Al excederse:
# 429 + Retry-After. /health queda exento. Ventana fija en memoria por proceso:
# si algún día hay más de una réplica, hay que mover el contador a un store
# compartido. Un valor inválido rompe el arranque a propósito (un typo que apague
# el límite en silencio es peor que no tenerlo).
# RATE_LIMIT_ENABLED=true          # sólo "false" o "0" lo apagan
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MCP_MAX=240           # POST /mcp/* por identidad y por ventana
# RATE_LIMIT_ADMIN_MAX=300         # /admin/api/*
# RATE_LIMIT_OAUTH_MAX=60          # /oauth/* y /.well-known/oauth-*
# RATE_LIMIT_DEFAULT_MAX=120       # el resto (estáticos del panel, discovery, 404)

# ── Identidad (OIDC) ──────────────────────────────────────────────────────────
# Cualquier proveedor con discovery document. Sin esto, /oauth/* responde 503 y
# el MCP no autentica. El redirect URI a registrar es <PUBLIC_URL>/oauth/callback.
#   Google         → https://accounts.google.com/.well-known/openid-configuration
#   Microsoft Entra→ https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
#   Okta           → https://<org>.okta.com/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Backcompat: preset Google. Equivale a OIDC_* con el discovery de Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Firma HS256 de los access tokens propios y del state OAuth. Requerido en prod:
# sin esto se genera uno por proceso y los tokens mueren en cada reinicio.
OAUTH_SIGNING_SECRET=

# URL pública del server (issuer OAuth y base de los redirect URIs).
PUBLIC_URL=http://localhost:3000

# Dominios de email permitidos (CSV). Vacío = sin restricción de dominio; la
# autorización real la da la membresía en al menos un workspace.
# ALLOWED_EMAIL_DOMAINS=example.com

# ── QA (evidencia) ────────────────────────────────────────────────────────────
# Allowlist de hosts para el evidence_url de submit_qa_results (CSV). Vacío o
# ausente = sin allowlist: igual se exige evidencia http(s) en todos los casos y
# se rechazan los hosts de relleno (example.com, localhost, 127.0.0.1, ::1 y
# cualquier host sin punto). Con la lista seteada, el host tiene que ser uno de
# los de la lista o un subdominio suyo.
# QA_EVIDENCE_HOST_ALLOWLIST=ci.miempresa.com,dev.azure.com

# ── Panel admin ───────────────────────────────────────────────────────────────
# Emails con acceso al panel (CSV).
ADMIN_EMAILS=

# Secreto HMAC de la cookie de sesión del panel. Si falta, se genera uno por
# proceso (las sesiones caen en cada reinicio).
ADMIN_SESSION_SECRET=

# Override del directorio del build del SPA (default: apps/admin/dist).
# ADMIN_UI_DIR=

# ── Tenant ────────────────────────────────────────────────────────────────────
# Tenant fijo del deploy (single-tenant). Default: default
# TENANT_ID=default

# ── Tests y desarrollo local ──────────────────────────────────────────────────
# Habilita los tests de integración contra Postgres real (usar una DB aparte).
# TEST_DATABASE_URL=postgres://sdlc:sdlc@localhost:5432/sdlc_test

# Ruta de carpetas para el test de integración de Drive (CSV, un segmento por carpeta).
# Sin esto el test usa `_ci-group,_ci-workspace`. Se skipea entero si no están
# GDRIVE_TEST_SA_JSON y GDRIVE_TEST_DRIVE_ID.
# GDRIVE_TEST_FOLDER_PATH=_ci-group,_ci-workspace

# NO PRENDER EN UN DEPLOY COMPARTIDO. Deja pasar un ctx sin el claim `workspaces`
# por las guardas de workspace. Prendido, un access token válidamente firmado pero
# sin el claim —uno emitido antes de que el claim existiera, o un refresh token
# viejo de esa época— pasa todas las guardas. Sólo "true" o "1" lo prenden.
# SDLC_ALLOW_UNSCOPED_CTX=false

# Sólo modo stdio (apps/server/src/mcp-stdio.ts). stdio no autentica: la identidad
# sale de env vars del proceso, así que se niega a arrancar si hay DATABASE_URL.
# Este opt-in ("true"/"1") lo deja apuntar a una base — usá una DB descartable,
# nunca la compartida. Ver docs/CONNECTING_CLIENTS.md § A.2.1.
# SDLC_STDIO_ALLOW_DATABASE=false
