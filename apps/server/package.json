{
  "name": "@sdlc/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "mcp": "node dist/mcp-stdio.js",
    "mcp:dev": "tsx src/mcp-stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'eslint pending — fase 5'",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/state/migrate-cli.ts",
    "seed:integrations": "tsx scripts/seed-integrations.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1063.0",
    "@fastify/static": "^8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@sdlc/adapters-contracts": "workspace:*",
    "@sdlc/catalog": "workspace:*",
    "@sdlc/core": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.0.0",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "openid-client": "^6.8.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.5",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
