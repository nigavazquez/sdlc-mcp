# Copiar a examples/02-fintech/.env.local (gitignored) y completar.

# Repo de la app (PRs + Issues). Ej.: GITHUB_OWNER=nigavazquez
GITHUB_OWNER=
GITHUB_REPO=fintech-demo-sdlc
# Token (fine-grained) con permisos Issues, Pull requests y Contents (read/write) sobre ese
# repo: Contents es para el doc store, que commitea PRD/RFC/ADR en docs/sdlc/. Lo lee el server como
# secret-ref aws-sm://github-token (backend env → SECRET_GITHUB_TOKEN).
SECRET_GITHUB_TOKEN=

# Secreto con el que el server firma tokens y con el que session.sh firma los de
# cada persona. Cualquier string largo; no lo reuses fuera de este ejemplo.
OAUTH_SIGNING_SECRET=

# Opcional
# PORT=3040
# DB_NAME=sdlc_fintech
