{
  "name": "@sdlc/catalog",
  "version": "0.0.1",
  "private": true,
  "description": "Versioned catalog of system prompts, skills and templates per role/phase. Curated by the COE.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "catalog.yaml",
    "roles",
    "skills",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seal": "node scripts/seal.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@sdlc/core": "workspace:*",
    "gray-matter": "^4.0.3",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
